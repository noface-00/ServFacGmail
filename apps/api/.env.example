PORT=3005
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GEMINI_API_KEY=
# Clave maestra (admin): gestiona API keys, conecta/desconecta cuentas y accede a todas las cuentas
SERVICE_API_KEY=

# Base de datos Postgres donde se persisten las cuentas de Gmail conectadas
DATABASE_URL=

# Clave para cifrar los tokens OAuth en la base de datos (hex de 32 bytes: `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY=

# Dominio público servido por Caddy (docker-compose.yml). El DNS debe apuntar al servidor
DOMAIN=

# Seguridad (todas opcionales)
# Orígenes de navegador permitidos por CORS, separados por comas. Vacío = ninguno (uso servidor a servidor)
# Ej. en desarrollo con apps/web: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
# Número de proxies delante del servicio (Dokploy/Traefik = 1). Necesario para que el rate limiting vea la IP real
TRUST_PROXY=1
# Peticiones por ventana de 15 min: global por IP y para /scan, /scan-sent y /download-pdf por API key
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_SCAN=30

# Variables adicionales para pruebas con la API real
SUPPLIER_EMAILS=
CLIENT_EMAILS=
SINCE_DATE=
