generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GmailAccount {
  email                String    @id
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime?
  scope                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
