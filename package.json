{
  "name": "gmail-scanner-service",
  "version": "1.0.0",
  "description": "Microservice to scan Gmail inboxes and parse PDF/XML/ZIP invoices, managing its own Gmail OAuth accounts",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec ts-node src/index.ts",
    "test": "jest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.5.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
