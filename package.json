{
  "name": "servfacgmail",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @servfac/api dev",
    "dev:web": "pnpm --filter @servfac/web dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "test": "pnpm --filter @servfac/api test",
    "lint": "pnpm --filter @servfac/web lint"
  }
}
